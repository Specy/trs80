{
  "name": "@specy/z80",
  "version": "1.2.2",
  "description": "Ready-to-use Z80 machine: assemble, run, and debug Z80 code with pluggable IO",
  "main": "dist/index.umd.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.umd.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "unpkg": "dist/index.umd.cjs",
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:dist": "node tests/dist-smoke.mjs",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "z80",
    "emulator",
    "assembler",
    "machine"
  ],
  "author": "Specy <specy.dev@gmail.com> (https://github.com/Specy)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Specy/trs80.git",
    "directory": "packages/z80-machine"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Specy/trs80/issues"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.59.4",
    "@types/node": "^24.13.4",
    "@typescript/typescript6": "^6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-dts": "^5.1.2",
    "z80-asm": "*",
    "z80-base": "*",
    "z80-disasm": "*",
    "z80-emulator": "*",
    "z80-inst": "*",
    "z80-logger": "*"
  }
}
